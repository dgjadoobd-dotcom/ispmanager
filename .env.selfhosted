# Self-Hosted ISP Manager Production Environment

# Server Configuration
DOMAIN=yourdomain.com
ENVIRONMENT=production
NODE_ENV=production
PORT=3001

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ispmanager
DB_USER=ispmanager
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# PostgreSQL Backups
POSTGRES_BACKUP_ENABLED=true
POSTGRES_BACKUP_HOUR=2
POSTGRES_BACKUP_RETENTION_DAYS=30

# ========================================
# SECURITY KEYS
# ========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_BASE64
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_KEY_BASE64
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_BASE64

# ========================================
# REDIS CACHE (Optional)
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ========================================
# RADIUS SERVER CONFIGURATION
# ========================================
# RADIUS Authentication Server
RADIUS_HOST=0.0.0.0
RADIUS_PORT=1812
RADIUS_SECRET=CHANGE_ME_RADIUS_SECRET_KEY
RADIUS_TIMEOUT=30

# RADIUS Accounting Server
RADIUS_ACCOUNTING_PORT=1813

# ========================================
# PIPRAPAY PAYMENT GATEWAY
# ========================================
# Sandbox (for testing): https://sandbox.piprapay.com
# Production: https://api.piprapay.com
PIPRAPAY_API_BASE_URL=https://sandbox.piprapay.com
PIPRAPAY_MERCHANT_ID=CHANGE_ME_MERCHANT_ID
PIPRAPAY_API_KEY=CHANGE_ME_API_KEY
PIPRAPAY_API_SECRET=CHANGE_ME_API_SECRET
PIPRAPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
PIPRAPAY_CURRENCY=BDT
PIPRAPAY_TIMEOUT=30000

# ========================================
# API CONFIGURATION
# ========================================
API_BASE_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
API_REQUEST_TIMEOUT=30000
API_MAX_REQUEST_SIZE=10mb

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_DIRECTORY=/var/log/ispmanager

# ========================================
# MIKROTIK INTEGRATION
# ========================================
MIKROTIK_TIMEOUT=10000
MIKROTIK_RETRY_ATTEMPTS=3
MIKROTIK_CONNECTION_POOL_SIZE=5

# ========================================
# HTTPS/SSL CONFIGURATION
# ========================================
# Let's Encrypt certificate paths (auto-updated by certbot)
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
SSL_PROTOCOL=TLSv1.2 TLSv1.3
SSL_CIPHERS=HIGH:!aNULL:!MD5

# ========================================
# PGADMIN (Database Management - Optional)
# ========================================
PGADMIN_DEFAULT_EMAIL=admin@ispmanager.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ========================================
# BACKUP & MAINTENANCE
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# ========================================
# MONITORING & ALERTS
# ========================================
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=300  # seconds
DISK_USAGE_WARNING_THRESHOLD=80  # percent
MEMORY_USAGE_WARNING_THRESHOLD=85  # percent

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=ISP Manager

# ========================================
# FRONTEND CONFIGURATION
# ========================================
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_ENVIRONMENT=production
VITE_APP_NAME=ISP Manager
VITE_APP_VERSION=1.0.0

# ========================================
# SYSTEM PERFORMANCE
# ========================================
WORKER_PROCESSES=auto
WORKER_CONNECTIONS=1024
CLIENT_BODY_SIZE=10m
KEEPALIVE_TIMEOUT=65

# ========================================
# SECURITY HEADERS
# ========================================
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_CSP=true
ENABLE_X_FRAME_OPTIONS=true
ENABLE_X_CONTENT_TYPE_OPTIONS=true

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# 2FA CONFIGURATION (Optional)
# ========================================
TWO_FACTOR_ENABLED=false
TWO_FACTOR_WINDOW=300  # seconds

# End of Configuration
